            "mimeType": "application/json",
            "text": "{\n  \"translations\": [\n    {\n      \"id\": \"ASV\",\n      \"label\": \"American Standard Version\",\n      \"abbreviation\": \"ASV\",\n      \"language\": \"en\",\n      \"textDirection\": \"ltr\",\n      \"year\": 1901,\n      \"canon\": \"protestant\",\n      \"philosophy\": \"formal\",\n      \"copyright\": \"American Standard Version (ASV). Public domain.\"\n    },\n    {\n      \"id\": \"BLB\",\n      \"label\": \"Berean Literal Bible\",\n      \"abbreviation\": \"BLB\",\n      \"language\": \"en\",\n      \"textDirection\": \"ltr\",\n      \"year\": 2016,\n      \"canon\": \"protestant\",\n      \"philosophy\": \"formal\",\n      \"copyright\": \"The Holy Bible, Berean Literal Bible, BLB is produced in cooperation with Bible Hub, Discovery Bible, OpenBible.com, and the Berean Bible Translation Committee. This text of God's Word has been dedicated to the public domain.\"\n    },\n    {\n      \"id\": \"BSB\",\n      \"label\": \"Berean Standard Bible\",\n      \"abbreviation\": \"BSB\",\n      \"language\": \"en\",\n      \"textDirection\": \"ltr\",\n      \"year\": 2016,\n      \"canon\": \"protestant\",\n      \"philosophy\": \"dynamic\",\n      \"copyright\": \"The Holy Bible, Berean Standard Bible, BSB is produced in cooperation with Bible Hub, Discovery Bible, OpenBible.com, and the Berean Bible Translation Committee. This text of God's Word has been dedicated to the public domain.\"\n    },\n    {\n      \"id\": \"CSB\",\n      \"label\": \"Christian Standard Bible\",\n      \"abbreviation\": \"CSB\",\n      \"language\": \"en\",\n      \"textDirection\": \"ltr\",\n      \"year\": 2017,\n      \"canon\": \"protestant\",\n      \"philosophy\": \"dynamic\",\n      \"copyright\": \"Copyright © 2017 by Holman Bible Publishers. All rights reserved. Verify distribution rights before publishing.\"\n    },\n    {\n      \"id\": \"ESV\",\n      \"label\": \"English Standard Version\",\n      \"abbreviation\": \"ESV\",\n      \"language\": \"en\",\n      \"textDirection\": \"ltr\",\n      \"year\": 2001,\n      \"canon\": \"protestant\",\n      \"philosophy\": \"formal\",\n      \"copyright\": \"The Holy Bible, English Standard Version. ESV® Text Edition: 2016. Copyright © 2001 by Crossway Bibles, a publishing ministry of Good News Publishers. Verify distribution rights before publishing.\"\n    },\n    {\n      \"id\": \"ISV\",\n      \"label\": \"International Standard Version\",\n      \"abbreviation\": \"ISV\",\n      \"language\": \"en\",\n      \"textDirection\": \"ltr\",\n      \"year\": 2011,\n      \"canon\": \"protestant\",\n      \"philosophy\": \"dynamic\",\n      \"copyright\": \"Copyright © 1995-2014 by ISV Foundation. All rights reserved internationally. Verify distribution rights before publishing.\"\n    },\n    {\n      \"id\": \"KJV\",\n      \"label\": \"King James Version\",\n      \"abbreviation\": \"KJV\",\n      \"language\": \"en\",\n      \"textDirection\": \"ltr\",\n      \"year\": 1611,\n      \"canon\": \"protestant\",\n      \"philosophy\": \"formal\",\n      \"copyright\": \"King James Version (KJV). Public domain.\"\n    },\n    {\n      \"id\": \"LEB\",\n      \"label\": \"Lexham English Bible\",\n      \"abbreviation\": \"LEB\",\n      \"language\": \"en\",\n      \"textDirection\": \"ltr\",\n      \"year\": 2012,\n      \"canon\": \"protestant\",\n      \"philosophy\": \"formal\",\n      \"copyright\": \"Scripture quotations marked LEB are from the Lexham English Bible. Copyright © 2012 Logos Bible Software. Lexham is a registered trademark of Logos Bible Software. https://lexhamenglishbible.com\"\n    },\n    {\n      \"id\": \"MEV\",\n      \"label\": \"Modern English Version\",\n      \"abbreviation\": \"MEV\",\n      \"language\": \"en\",\n      \"textDirection\": \"ltr\",\n      \"year\": 2014,\n      \"canon\": \"protestant\",\n      \"philosophy\": \"formal\",\n      \"copyright\": \"Scripture taken from the Modern English Version. Copyright © 2014 by Military Bible Association. Verify distribution rights before publishing.\"\n    },\n    {\n      \"id\": \"MSB\",\n      \"label\": \"Majority Standard Bible\",\n      \"abbreviation\": \"MSB\",\n      \"language\": \"en\",\n      \"textDirection\": \"ltr\",\n      \"year\": 2023,\n      \"canon\": \"protestant\",\n      \"philosophy\": \"dynamic\",\n      \"copyright\": \"The Holy Bible, Majority Standard Bible, MSB is produced in cooperation with Bible Hub, Discovery Bible, unfoldingWord, Bible Aquifer, OpenBible.com, and the Berean Bible Translation Committee. This text of God's Word has been dedicated to the public domain.\"\n    },\n    {\n      \"id\": \"NET\",\n      \"label\": \"New English Translation\",\n      \"abbreviation\": \"NET\",\n      \"language\": \"en\",\n      \"textDirection\": \"ltr\",\n      \"year\": 1996,\n      \"canon\": \"protestant\",\n      \"philosophy\": \"dynamic\",\n      \"copyright\": \"Scripture quoted by permission. Quotations designated (NET) are from the NET Bible® copyright ©1996, 2019 by Biblical Studies Press, L.L.C. http://netbible.com All rights reserved.\"\n    },\n    {\n      \"id\": \"NIV\",\n      \"label\": \"New International Version\",\n      \"abbreviation\": \"NIV\",\n      \"language\": \"en\",\n      \"textDirection\": \"ltr\",\n      \"year\": 1978,\n      \"canon\": \"protestant\",\n      \"philosophy\": \"dynamic\",\n      \"copyright\": \"The Holy Bible, New International Version®, NIV®. Copyright © 1973, 1978, 1984, 2011 by Biblica, Inc.™ Verify distribution rights before publishing.\"\n    },\n    {\n      \"id\": \"NKJV\",\n      \"label\": \"New King James Version\",\n      \"abbreviation\": \"NKJV\",\n      \"language\": \"en\",\n      \"textDirection\": \"ltr\",\n      \"year\": 1982,\n      \"canon\": \"protestant\",\n      \"philosophy\": \"formal\",\n      \"copyright\": \"New King James Version®. Copyright © 1982 by Thomas Nelson. Verify distribution rights before publishing.\"\n    },\n    {\n      